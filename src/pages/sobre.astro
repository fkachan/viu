---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { separarSinal } from '../lib/posts';

const pagina = await getEntry('pages', 'sobre');
if (!pagina) throw new Error('Falta o arquivo src/content/pages/sobre.md');
const { Content } = await render(pagina);
const { texto, sinal } = separarSinal(pagina.data.title);
---
<Base title={pagina.data.title} description="Quem escreve o viu, e por quê.">
  <article class="pagina">
    <h1 class="display">{texto}<span class="pontuacao">{sinal || '.'}</span></h1>
    <div class="prosa"><Content /></div>
  </article>
</Base>

<style>
  .pagina { margin-top: 96px; display: flex; flex-direction: column; gap: 32px; }
  .pagina h1 { margin: 0; }
  @media (max-width: 600px) { .pagina { margin-top: 56px; gap: 24px; } }
</style>
