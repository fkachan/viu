---
import Base from '../layouts/Base.astro';
import { site } from '../config';

const temButtondown = site.buttondown.trim().length > 0;
const action = `https://buttondown.com/api/emails/embed-subscribe/${site.buttondown}`;
---
<Base title="Newsletter" description="Receba os textos do viu, por e-mail: um por semana, sem spam, sem bolha.">
  <section class="nl">
    <h1 class="display">Viu, vamos conversar<span class="pontuacao">.</span></h1>
    <p class="lead">Um texto por semana, por e-mail. Sem spam, sem bolha, sem rastreadores. Sai quando quiser, em um clique.</p>

    {temButtondown ? (
      <form class="form-nl" action={action} method="post">
        <label for="email" class="visually-hidden">Seu e-mail</label>
        <input id="email" name="email" type="email" required placeholder="seu@email.com" autocomplete="email" />
        <input type="hidden" name="embed" value="1" />
        <button type="submit">Quero receber</button>
      </form>
    ) : (
      <p class="muted">A lista abre em breve. Enquanto isso, o <a href="/rss.xml">RSS</a> já funciona.</p>
    )}
  </section>
</Base>

<style>
  .nl { margin-top: 96px; display: flex; flex-direction: column; gap: 24px; }
  .nl h1, .nl p { margin: 0; }
  .nl .lead { max-width: 520px; }
  .form-nl { margin-top: 8px; }
  @media (max-width: 600px) { .nl { margin-top: 56px; gap: 20px; } }
</style>
